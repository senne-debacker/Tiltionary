{
  "expo": {
    "name": "TiltTekenen",
    "slug": "TiltTekenen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senne-debacker.TiltTekenen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Sta Tiltionary toe om je tekeningen op te slaan in je fotobibliotheek.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-router"
    ],
    "scheme": "tiltionary",
    "experiments": {
      "typedRoutes": true
    }
  }
}
